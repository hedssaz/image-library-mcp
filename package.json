{
  "name": "image-library-mcp",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ui/build.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "db:local": "wrangler d1 migrations apply DB --local",
    "check": "wrangler types cloudflare/runtime.d.ts --include-env false && tsc",
    "test:cloudflare": "node --test cloudflare/integration.test.mjs",
    "build:worker": "npm run build && wrangler deploy --dry-run --outdir dist",
    "test:ui": "node --test tests/viewer.test.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.0",
    "@types/node": "22.20.4",
    "@types/omggif": "1.0.5",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "wrangler": "4.138.0",
    "@modelcontextprotocol/client": "2.0.0"
  },
  "dependencies": {
    "@jsquash/webp": "1.5.0",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.24.0",
    "fast-png": "8.0.0",
    "jpeg-js": "0.4.4",
    "omggif": "1.0.10",
    "unicode-case-folding": "1.1.1",
    "zod": "4.6.5"
  },
  "cloudflare": {
    "bindings": {
      "MCP_TOKEN": {
        "description": "自己填写一个好记的 key，例如 my-cat-2026。连接 MCP 时填同一个值；不要求长度，不要留空或含空格、中文。这不是 Cloudflare API token。"
      },
      "SHOW_IMAGE_CONTENT": {
        "description": "保持 true 即可：展示表情包时也把原图交给 AI。false 只返回卡片数据和链接；get 始终返回原图。"
      },
      "DB": {
        "description": "保存图片名字、别名和描述的数据库。让向导自动创建，保持默认部署命令即可。"
      },
      "IMAGES": {
        "description": "保存原始图片的仓库。先在 Cloudflare 账户中开通 R2，再让向导创建；开通可能需要填写付款资料。"
      }
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
